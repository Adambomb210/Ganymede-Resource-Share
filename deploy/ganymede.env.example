# Ganymede coordinator environment (docs/02-architecture-v2.md 6.5).
#
# Copy to `ganymede.env` (git-ignored) and fill in real values. Every variable
# here is read by ganymede/coordinator/config.py -- Settings.from_env() and
# StorageConfig.from_env() -- nothing here is invented for this file; if
# config.py doesn't read it, it isn't listed. Nothing in the codebase should
# ever contain a hostname or credential directly: this file is the only place
# those live, and moving from a laptop to a server to R2 should be an edit to
# this file, not a code change.

# ---------------------------------------------------------------------------
# Storage (StorageConfig.from_env)
# ---------------------------------------------------------------------------

# Public S3-compatible endpoint workers and the coordinator both resolve.
# MUST be byte-identical to MinIO's own MINIO_SERVER_URL (see
# docker-compose.yml's comment on the presigned-URL host footgun) -- never a
# container-internal address or "localhost" once anything other than this
# same compose file needs to reach it.
STORAGE_HOST=http://localhost:9000

# Bucket and region. "auto" is the region Cloudflare R2 expects; MinIO and AWS
# S3 both accept an explicit region string.
S3_BUCKET=ganymede
S3_REGION=us-east-1

# Store credentials. Also doubles as MinIO's own root user/password in
# docker-compose.yml -- rotate both together.
S3_ACCESS_KEY=changeme-access-key
S3_SECRET_KEY=changeme-secret-key-please-generate-a-real-one

# How long a presigned PUT/GET URL stays valid.
S3_PRESIGN_EXPIRY_SEC=900

# ---------------------------------------------------------------------------
# Coordinator (Settings.from_env)
# ---------------------------------------------------------------------------

# Where the SQLite database lives. Point this at the coordinator_db volume
# (docker-compose.yml) -- see that file's comment on why it isn't the OS disk.
GANYMEDE_DB=/var/lib/ganymede/coordinator.db

# Public host for the FastAPI app -- the other half of the "two subdomains"
# split in 6.5 (STORAGE_HOST is the other).
COORDINATOR_HOST=http://localhost:8000

# TLS is mandatory in production: a bearer token over plain HTTP is a token in
# the clear on every hop between a volunteer's home network and here. `true`
# is the production setting -- only turn this off for a local compose run
# where nothing crosses a network you don't control, and never in bring-up or
# production, even temporarily.
GANYMEDE_REQUIRE_TLS=false

# How long a worker's task lease lasts before it's reclaimed as abandoned.
GANYMEDE_LEASE_SEC=900

# Expected interval between a worker's heartbeat calls.
GANYMEDE_HEARTBEAT_SEC=60

# A worker claiming with less than this much usable time left in the round
# gets 204 rather than work it can't finish (3.2).
GANYMEDE_MIN_USABLE_SEC=300

# Fixed overheads subtracted from remaining round time before sizing a
# per-worker step budget (3.5).
GANYMEDE_EST_DOWNLOAD_SEC=60
GANYMEDE_EST_UPLOAD_SEC=30
GANYMEDE_SAFETY_MARGIN_SEC=60

# Acceptance gate 4: reject a submitted tensor whose Frobenius norm exceeds
# this multiple of the cohort median (5.1).
GANYMEDE_NORM_REJECT_K=5.0

# No single worker's aggregation weight may exceed this multiple of the
# median contribution (5.2).
GANYMEDE_DOMINANCE_CAP=2.0

# A worker that can't reach this fraction of the round's median budget isn't
# offered work for this run (3.5); it stays eligible for others.
GANYMEDE_THROUGHPUT_FLOOR=0.10

# scripts/gc.py's default retention window: how many of a run's most recent
# closed rounds keep their worker submission artifacts before gc considers
# them stale (6.6, "Retention and garbage collection").
GANYMEDE_GC_KEEP_ROUNDS=3

# How long a wide (gpu_count > 1) job's device reservation survives before a
# dead reserver stops dark-carding cards nobody is using (docs/14 §6). A
# blocked wide job re-reserves on every claim poll, so this only has to
# outlive one poll gap, not the whole accumulation window -- and it stays
# well under GANYMEDE_LEASE_SEC so a dead reserver loses its hold in minutes,
# not for most of a lease.
GANYMEDE_DEVICE_RESERVATION_TTL_SEC=300

# ---------------------------------------------------------------------------
# A 4-GPU host (docs/14), for reference
# ---------------------------------------------------------------------------
#
# Everything above this point is read by the *coordinator* process
# (Settings.from_env / StorageConfig.from_env, this file's own header
# comment). What follows is not: it is the environment a multi-GPU
# contributor's host agent and worker process read directly (``os.environ``
# in ganymede/worker/loop.py, probe.py, sandbox.py -- not HostConfig, which
# has its own file, host.json, per INSTALL.md). Collected here anyway,
# because a contributor standing up a four-card box has to find every knob
# that changes on that box in one place rather than hunting three modules'
# worth of docstrings for it. None of it applies to the common case -- one
# donated card -- which needs none of these set at all.

# Which machine this is, when a contributor runs more than one identical box
# (docs/14 §2's "a fleet of identical machines is not one worker"). Without
# it, two containers on two physical hosts with the same GPU model and no
# platform-supplied node id (SALAD_MACHINE_ID / RUNPOD_POD_ID /
# VAST_CONTAINERLABEL / HOSTNAME, tried in that order) would fingerprint as
# the same worker and silently collide. Required in practice for any
# contributor with more than one host; harmless to set on a single machine.
GANYMEDE_NODE_ID=host-a

# Where a contained job's scratch lives on this host (docs/11 §2.3). Absent
# disables the contained-job path entirely -- a host opts in to running
# submitter code, it is not the default. Set by the host agent's own
# worker_env() when it starts the worker from host.json's job_scratch_dir;
# listed here for a worker run directly, outside the agent's tick.
GANYMEDE_JOB_SCRATCH=/var/lib/ganymede/jobs

# CPU slots this host offers, for a CPU-backend worker only (docs/14 §2).
# Defaults to 1 even on a many-core box -- _describe_cpu reports vram_mb as
# total system RAM, so raising this is a deliberate operator act, not
# something the probe guesses at. Irrelevant on a GPU host; listed here only
# because it is the other axis "how wide is this worker" can vary along.
GANYMEDE_CPU_SLOTS=1

# Which of this host's devices a contained job's container may see, as
# Docker's own --gpus value ("all", "device=0", "device=0,2,3", ...).
# Deliberately unset by default (docs/14 §2) -- an operator who leaves it
# unset gets the per-lease pin, computed from the ledger's own allocation,
# which is what makes several leases on one 4-card box each see only their
# own card. Setting it explicitly overrides that outright, with a warning
# logged when a real allocation existed underneath. Leave this commented out
# unless pinning every job on this host to the same fixed device set is
# actually what you want.
# GANYMEDE_JOB_GPUS=all
