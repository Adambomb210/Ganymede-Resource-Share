<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Ganymede host agent tick (docs/02-architecture-v2.md 7 and 4.1).

  macOS has no container path at all: 6.8 records that the runtime here cannot
  reach the GPU, so a Mac contributes through the native pip install or not at
  all. This drives the same console script the systemd timer drives on Linux.

  This is a LaunchAgent rather than a LaunchDaemon, which is the real decision
  on this platform; packaging/README.md argues it, along with the cadence and
  the reason the contributor key is not in this file.

  Note on editing: XML forbids a doubled hyphen inside a comment, and a plist
  that will not parse is a plist launchd silently refuses to load. Keep prose
  in README.md, where that cannot bite.
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.ganymede.host</string>

    <!-- Absolute path, rewritten by install-macos.sh to wherever pip put it. -->
    <key>ProgramArguments</key>
    <array>
        <string>/usr/local/bin/ganymede-host</string>
        <string>--once</string>
    </array>

    <!-- 300 s, matching packaging/ganymede-host.timer. StartInterval counts
         from the end of the previous run, which is what a polling tick wants
         rather than a wall-clock instant. -->
    <key>StartInterval</key>
    <integer>300</integer>

    <!-- Tick immediately on load, so someone who has just installed this sees
         something happen instead of waiting out a cold interval. -->
    <key>RunAtLoad</key>
    <true/>

    <!-- Not a long-running process: StartInterval governs the next run, and a
         restart-on-exit policy would fight it. -->
    <key>KeepAlive</key>
    <false/>

    <key>StandardOutPath</key>
    <string>/var/log/ganymede/host-agent.log</string>
    <key>StandardErrorPath</key>
    <string>/var/log/ganymede/host-agent.err</string>

    <!-- No EnvironmentVariables key, deliberately. A plist in
         ~/Library/LaunchAgents is mode 0644; the contributor key belongs in
         host.json at 0600. See README.md. -->

    <key>ProcessType</key>
    <string>Background</string>
</dict>
</plist>
